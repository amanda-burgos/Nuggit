# Nuggit: AI configuration. Copy this file to ".env" (never commit .env) and fill in what
# you need. Everything is optional. Priority: real environment variables > .env >
# Ajustes (settings.json) > config/ai.defaults.json. Restart Nuggit after changing it.
# Nuggit reads .env from the project folder (development) or from its data folder.

# --- Which AI and model ---
# gemini | ollama | openaiCompatible | auto
NUGGIT_AI_PROVIDER=
# Model for the provider above (in auto mode: for the first one of the order).
NUGGIT_AI_MODEL=
# The order auto mode tries them in, separated by commas.
NUGGIT_AI_ORDER=openaiCompatible,ollama,gemini

# --- Gemini (online, needs a key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
NUGGIT_GEMINI_MODEL=

# --- Ollama (on this computer) ---
NUGGIT_OLLAMA_URL=http://127.0.0.1:11434
NUGGIT_OLLAMA_MODEL=

# --- Your own server that speaks the OpenAI API ---
# Base URLs ending in /v1: the main one first, then the backups.
NUGGIT_OPENAI_BASE_URLS=
NUGGIT_OPENAI_MODEL=
NUGGIT_OPENAI_API_KEY=

# --- Per agent (optional): dip, tenderizer, dailies, actions ---
# They win over NUGGIT_AI_PROVIDER / NUGGIT_AI_MODEL for that agent only.
# NUGGIT_AGENT_TENDERIZER_PROVIDER=ollama
# NUGGIT_AGENT_TENDERIZER_MODEL=llama3.1:8b
# NUGGIT_AGENT_DIP_PROVIDER=
# NUGGIT_AGENT_DIP_MODEL=
# NUGGIT_AGENT_DAILIES_PROVIDER=
# NUGGIT_AGENT_DAILIES_MODEL=
# NUGGIT_AGENT_ACTIONS_PROVIDER=
# NUGGIT_AGENT_ACTIONS_MODEL=

# --- Demo of self-correction (for class) ---
# These agents get their first answer cut in half on purpose: they receive the error and fix
# it. Each try shows up in logs/agents.log marked "demo". Leave empty for normal use.
NUGGIT_DEMO_BREAK_FIRST_ANSWER=
